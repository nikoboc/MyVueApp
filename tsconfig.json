{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "preserve",

    /* 厳格化の設定 — docs/05 §1 に対応。エラーを抑制する目的で緩めてはならない。 */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* パスエイリアス — docs/05 §10。vite.config.ts と同期させること。
       baseUrl は指定しない。TypeScript 7.0 で廃止予定であり、4.4 以降は paths を
       単独で使用できる。相対パスは tsconfig.json の位置を基準に解決される。 */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "env.d.ts"
  ]
}
